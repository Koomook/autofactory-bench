      "kind": "json",
      "text": "{\n  \"axis_parameters\": {\n    \"a\": {\n      \"position_unit\": \"deg\",\n      \"speed_unit\": \"deg/s\",\n      \"acceleration_unit\": \"deg/s²\"\n    },\n    \"b\": {\n      \"position_unit\": \"mm\",\n      \"speed_unit\": \"mm/s\",\n      \"acceleration_unit\": \"mm/s²\",\n      \"natural_frequency_rad_s\": 40,\n      \"damping_ratio\": 1,\n      \"acceleration_limit\": 6000,\n      \"speed_limit\": 1000,\n      \"braking_deceleration\": 8000\n    }\n  },\n  \"axis_units\": {\n    \"a\": \"deg\",\n    \"b\": \"mm\"\n  }\n}",
